# Exemplo de variáveis de ambiente (copie para .env e ajuste)
# Atualmente o projeto usa principalmente parâmetros via dataclass,
# mas este arquivo serve como base para futuras configurações.

# Caminho padrão da planilha (opcional)
# PLANILHA_PACIENTES=data/examples/pacientes_exemplo.csv

# Intervalo entre envios de mensagem (segundos)
# INTERVALO_SEGUNDOS=25

# Código do país para normalização de telefone
# CODIGO_PAIS=+55
